{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-chat-agent/contracts/0.3.0/confirm-plan",
  "type": "object",
  "required": ["taskVersion", "planVersion", "alternativeId", "editedParts", "contentHash", "idempotencyKey"],
  "properties": {
    "taskVersion": { "type": "integer", "minimum": 1 },
    "planVersion": { "type": "integer", "minimum": 1 },
    "alternativeId": { "type": "string", "minLength": 1 },
    "editedParts": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["type"], "properties": { "type": { "enum": ["text", "approved_sticker"] }, "content": { "type": "string" }, "mediaAssetId": { "type": "string" } } } },
    "contentHash": { "type": "string", "minLength": 1 },
    "idempotencyKey": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
