import test from 'node:test';import assert from 'node:assert/strict';
import {registeredProvidersFromEnv} from './compatible-provider.mts';
test('configured Qwen sends non-thinking JSON requests and reads metered response without vendor thinking objects',async()=>{
 const env={AI_V2_PROVIDERS_JSON:JSON.stringify([{key:'qwen-test',providerId:'qwen',modelId:'qwen3.7-flash',modelVersion:'test',baseUrl:'https://qwen.invalid/compatible-mode/v1/',apiKeyEnv:'AI_V2_TEST_QWEN_KEY',dataRegion:'test',retentionPolicy:'test',tasks:['decision'],thinking:'disabled',thinkingParameter:'enable_thinking'}]),AI_V2_TEST_QWEN_KEY:'synthetic-private-key'};
 let calls=0;const fetcher:typeof fetch=async(url,init)=>{calls++;assert.equal(String(url),'https://qwen.invalid/compatible-mode/v1/chat/completions');const body=JSON.parse(String(init?.body));assert.equal(body.enable_thinking,false);assert.equal(body.thinking,undefined);assert.deepEqual(body.response_format,{type:'json_object'});return new Response(JSON.stringify({choices:[{message:{content:'{"action":"wait"}'},finish_reason:'stop'}],usage:{prompt_tokens:17,completion_tokens:9}}),{status:200});};
 const p=registeredProvidersFromEnv(env,fetcher).decisions[0]!;const result=await p.decide({context:{messages:[],facts:[]} as any,policy:{goal:'test',restrictions:[]} as any,signal:new AbortController().signal});assert.equal(calls,1);assert.equal(result.usage?.inputTokens,17);assert.equal((result.decision as {action:string}).action,'wait');assert.equal(JSON.stringify(p).includes(env.AI_V2_TEST_QWEN_KEY),false);
 for(const parameter of ['unknown',false])assert.throws(()=>registeredProvidersFromEnv({...env,AI_V2_PROVIDERS_JSON:JSON.stringify([{...JSON.parse(env.AI_V2_PROVIDERS_JSON)[0],thinkingParameter:parameter}])}),/INVALID_MODEL_REGISTRY/);
});
