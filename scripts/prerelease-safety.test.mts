import test from 'node:test';import assert from 'node:assert/strict';import {resolve} from 'node:path';import {managedPath,parsePrivateProfile,prereleaseEnvironment} from './prerelease-safety.mts';
test('prerelease management refuses operations on the root or outside the managed tree',()=>{const root=resolve('test-results/prerelease');assert.equal(managedPath(root,resolve(root,'qq/data')),resolve(root,'qq/data'));for(const p of [root,resolve(root,'..'),resolve(root,'../daily-data')])assert.throws(()=>managedPath(root,p),/OUTSIDE_ROOT/);});
test('prerelease children discard inherited and profile cloud/bridge secrets and force local paused operation',()=>{const env=prereleaseEnvironment({PATH:'test',AI_V2_PROVIDERS_JSON:'secret',DEEPSEEK_API_KEY:'secret',WECHAT_TOKEN:'secret',PGPASSWORD:'secret',NODE_OPTIONS:'secret'},{DATABASE_URL:'postgres://localhost/clone',OWNER_ID:'test',PORT:'1234',AI_V2_PROVIDERS_JSON:'profile-secret',DEEPSEEK_API_KEY:'profile-secret'});assert.equal(env.AI_V2_PROVIDERS_JSON,undefined);assert.equal(env.DEEPSEEK_API_KEY,undefined);assert.equal(env.WECHAT_TOKEN,undefined);assert.equal(env.PGPASSWORD,undefined);assert.equal(env.START_PAUSED,'1');assert.equal(env.COLLECTION_ENABLED,'0');assert.equal(env.QQ_ENABLE_OUTBOUND,'0');assert.equal(env.WECHAT_ENABLE_OUTBOUND,'0');assert.equal(env.INTELLIGENCE_PROVIDER,'persistent-fake');});
test('private profile parser validates keys without evaluating shell text',()=>{assert.deepEqual(parsePrivateProfile('A=$(secret)\n# comment\nB=x'),{A:'$(secret)',B:'x'});assert.throws(()=>parsePrivateProfile('{"bad-key":"x"}'),/INVALID/);});
