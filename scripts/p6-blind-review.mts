/** Local review page: no network, provider metadata, automatic choices or sending. */
import {readFile,writeFile,stat} from 'node:fs/promises';
import {createHash} from 'node:crypto';
const [packFile,outputFile,...extra]=process.argv.slice(2);
if(!packFile||!outputFile||extra.length||(await stat(packFile)).size>5_000_000)throw new Error('BLIND_REVIEW_ARGUMENT_INVALID');
const pack=JSON.parse(await readFile(packFile,'utf8'));
if(pack.schemaVersion!==1||!Array.isArray(pack.items)||!pack.items.length||pack.items.some((p:any)=>!p||typeof p.sampleId!=='string'||!Array.isArray(p.input)||!Array.isArray(p.A)||!Array.isArray(p.B)||[...p.input,...p.A,...p.B].some(t=>typeof t!=='string'))||new Set(pack.items.map((p:any)=>p.sampleId)).size!==pack.items.length)throw new Error('INVALID_BLIND_PACK');
const encoded=JSON.stringify(pack).replaceAll('<','\\u003c').replaceAll('>','\\u003e').replaceAll('&','\\u0026');
const key=createHash('sha256').update(encoded).digest('hex');
const html=`<!doctype html><html lang="zh-CN"><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; connect-src 'none'; img-src 'none'"><title>回复对比评分</title>
<style>*{box-sizing:border-box}body{margin:0;background:#f2f6f5;color:#18352f;font:16px/1.65 system-ui,sans-serif}main{max-width:980px;margin:auto;padding:24px 18px}h1{font-size:26px;margin:0}h2{font-size:20px}.muted{color:#637873}header,.panel{margin-bottom:20px}article,.panel{border:1px solid #d4e2dd;border-radius:16px;background:white;padding:20px}.columns{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:18px}.candidate{padding:12px 0;border-bottom:1px solid #e5ece9;white-space:pre-wrap;overflow-wrap:anywhere}.candidate:last-child{border:0}button{font:inherit;padding:10px 16px;border:1px solid #b8cfc6;border-radius:10px;background:white;color:#18352f;cursor:pointer}button:disabled{opacity:.45;cursor:default}button[aria-pressed=true],.primary{background:#187765;color:white}nav,.choices{display:flex;gap:10px;flex-wrap:wrap;margin:18px 0}.incoming{white-space:pre-wrap;overflow-wrap:anywhere}progress{width:100%;height:12px}#counter{font-weight:600}small{display:block}@media(max-width:640px){main{padding:18px 12px}.columns{grid-template-columns:1fr}article,.panel{padding:16px}h1{font-size:23px}.choices button{flex:1 1 40%}}</style>
<main><header><h1>回复对比评分</h1><p class="muted">请选择更像你、事实更可靠的一组。拿不准可以跳过，稍后回来评分。</p><div id="counter"></div><progress id="progress" value="0"></progress></header>
<section class="panel"><h2>当前聊天</h2><div id="incoming" class="incoming"></div></section>
<div class="columns"><article><h2>回复 A</h2><div id="A"></div></article><article><h2>回复 B</h2><div id="B"></div></article></div>
<section aria-label="选择更合适的回复"><div class="choices"><button data-choice="A">A 更合适</button><button data-choice="B">B 更合适</button><button data-choice="tie">两组一样好</button><button data-choice="neither">都不适合</button></div></section>
<nav><button id="prev">上一题</button><button id="next">下一题</button><button id="export" class="primary" disabled>导出我的评分</button></nav><p id="message" class="muted" aria-live="polite"></p><small class="muted">评分仅保存在当前浏览器。导出后把评分文件交给项目负责人汇总；此页面不会发送聊天消息。</small></main>
<script>const pack=${encoded};const storageKey='chat-agent-blind-${key}';const valid=new Set(['A','B','tie','neither']);let saved={};try{const old=JSON.parse(localStorage.getItem(storageKey)||'{}');for(const p of pack.items)if(valid.has(old[p.sampleId]))saved[p.sampleId]=old[p.sampleId];}catch{}let index=0;const el=id=>document.getElementById(id);
function render(){const item=pack.items[index];el('incoming').textContent=item.input.map(line=>line.replace(/^contact：/,'对方：').replace(/^owner：/,'本人：').replace(/^agent：/,'助手：')).join('\\n');for(const side of ['A','B']){el(side).replaceChildren();for(const text of item[side]){const p=document.createElement('div');p.className='candidate';p.textContent=text;el(side).appendChild(p);}}const rated=Object.keys(saved).length;el('counter').textContent='第 '+(index+1)+' / '+pack.items.length+' 题 · 已评分 '+rated+' 题';el('progress').max=pack.items.length;el('progress').value=rated;el('prev').disabled=index===0;el('next').disabled=index===pack.items.length-1;el('export').disabled=rated===0;for(const button of document.querySelectorAll('[data-choice]'))button.setAttribute('aria-pressed',String(saved[item.sampleId]===button.dataset.choice));}
for(const button of document.querySelectorAll('[data-choice]'))button.onclick=()=>{saved[pack.items[index].sampleId]=button.dataset.choice;try{localStorage.setItem(storageKey,JSON.stringify(saved));el('message').textContent='本题评分已保存，可以继续下一题。';}catch{el('message').textContent='浏览器未保存评分，请在关闭前导出。';}render();};el('prev').onclick=()=>{if(index>0){index--;el('message').textContent='';render();}};el('next').onclick=()=>{if(index<pack.items.length-1){index++;el('message').textContent='';render();}};
el('export').onclick=()=>{const ratings=pack.items.filter(p=>valid.has(saved[p.sampleId])).map(p=>({sampleId:p.sampleId,reviewerId:'owner',choice:saved[p.sampleId]}));if(!ratings.length)return;const url=URL.createObjectURL(new Blob([JSON.stringify(ratings,null,2)],{type:'application/json'}));const link=document.createElement('a');link.href=url;link.download='reply-review-ratings.json';link.click();setTimeout(()=>URL.revokeObjectURL(url),1000);el('message').textContent='评分文件已导出，共 '+ratings.length+' 题。';};render();</script></html>`;
await writeFile(outputFile,html,{flag:'wx',mode:0o600});console.log(JSON.stringify({reviewPageCreated:true,questions:pack.items.length,defaultVotes:0,networkEnabled:false}));
