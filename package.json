{
  "name": "personal-chat-agent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "migrate": "node scripts/migrate.mts",
    "test:unit": "node --test \"packages/**/*.test.mts\"",
    "test:app": "node --test apps/core/*.test.mts apps/bridge/*.test.mts apps/web/server/owner-http.test.mts apps/web/server/browser-crypto.test.mts",
    "test:tools": "node --test scripts/*.test.mts",
    "test:contracts": "node --test tests/contracts/*.test.mts",
    "test:integration": "node --test tests/integration/*.test.mts",
    "test:e2e": "node --test tests/e2e/*.test.mts",
    "build:web": "npm --prefix apps/web run build",
    "owner:password": "node scripts/owner-password.mts",
    "serve:owner": "node apps/web/server/main.mts",
    "serve:core": "node apps/core/main.mts",
    "serve:bridge": "node apps/bridge/main.mts",
    "serve:wechat-receive": "node apps/bridge/wechat-main.mts",
    "serve:local": "node scripts/local-stack.mts",
    "smoke:deepseek-candidate": "node scripts/deepseek-candidate-smoke.mts",
    "spike:posture": "node scripts/qq-spike-summary.mts posture",
    "spike:preflight": "node scripts/qq-spike-preflight.mts",
    "spike:report": "node scripts/qq-spike-report.mts",
    "spike:shape": "node scripts/qq-raw-shape.mts",
    "spike:summary": "node scripts/qq-spike-summary.mts summary",
    "spike:manifest": "node scripts/qq-spike-manifest.mts",
    "verify": "npm run test:unit && npm run test:app && npm run test:tools && npm run test:contracts && npm run test:integration && npm run build:web && npm run test:e2e",
    "eval:p6": "node scripts/p6-replay.mts",
    "test:p6": "node scripts/p6-verify.mts",
    "score:p6": "node scripts/p6-blind-score.mts",
    "prerelease": "node scripts/prerelease.mts",
    "eval:p6:real": "node scripts/p6-real-model.mts"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "qrcode": "1.5.4",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
