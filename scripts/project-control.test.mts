import test from 'node:test';import assert from 'node:assert/strict';import {mkdtemp,mkdir,writeFile,rm} from 'node:fs/promises';import {tmpdir} from 'node:os';import {join} from 'node:path';import {currentProject,releaseIdentity} from './project-control.mts';import {projectRelease} from '../packages/infrastructure/release.mts';
test('unified entry retains the current authorized trial and hashes delivered artifacts without exposing configuration',async()=>{
 const root=await mkdtemp(join(tmpdir(),'project-entry-'));try{const privateRoot=join(root,'private','trial'),manifest=join(privateRoot,'manifest.json');await mkdir(privateRoot,{recursive:true});await mkdir(join(root,'.local-prerelease'));await mkdir(join(root,'apps/web/build'),{recursive:true});await mkdir(join(root,'output/android'),{recursive:true});
 const config={root:privateRoot,prereleaseRoot:root,ownerAuthorized:true,automaticSendAuthorized:false,persistent:true};await writeFile(manifest,JSON.stringify(config));await writeFile(join(root,'.local-prerelease/qq-candidate-current.json'),JSON.stringify({root:privateRoot,manifest}));await writeFile(join(root,'apps/web/build/index.html'),'synthetic build');await writeFile(join(root,`output/android/reply-assistant-${projectRelease.androidVersion}-debug.apk`),'synthetic APK');
 assert.deepEqual(await currentProject(root),{manifest,privateRoot});const version=await releaseIdentity(root);assert.equal(version.desktopVersion,projectRelease.desktopVersion);assert.match(version.webHash,/^[a-f0-9]{64}$/);assert.match(version.apkHash!,/^[a-f0-9]{64}$/);
 await writeFile(manifest,JSON.stringify({...config,automaticSendAuthorized:true}));await assert.rejects(currentProject(root),/PROJECT_SCOPE_INVALID/);
 }finally{await rm(root,{recursive:true,force:true});}
});
