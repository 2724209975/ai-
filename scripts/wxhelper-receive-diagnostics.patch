diff --git a/app/wxhelper/src/receive_diagnostics.h b/app/wxhelper/src/receive_diagnostics.h
new file mode 100644
--- /dev/null
+++ b/app/wxhelper/src/receive_diagnostics.h
@@ -0,0 +1,11 @@
+#pragma once
+#include <atomic>
+namespace wxhelper {
+// Process-lifetime counters; no message contents, identifiers or paths.
+struct ReceiveDiagnostics {
+  std::atomic<unsigned long long> observed{0}, text{0}, type51{0};
+  std::atomic<unsigned long long> queued{0}, queue_failed{0};
+  std::atomic<unsigned long long> http_started{0}, http_2xx{0}, http_failed{0}, parse_failed{0};
+  static ReceiveDiagnostics& Get() { static ReceiveDiagnostics value; return value; }
+};
+}
