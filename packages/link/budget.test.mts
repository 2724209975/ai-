import test from 'node:test';
import assert from 'node:assert/strict';
import {MemoryLinkStore,PgLinkStore} from './store.mts';
import {randomBytes} from 'node:crypto';
import {readFile} from 'node:fs/promises';
import {LinkBudget} from './budget.mts';
import {PaidReplayBudget} from '../ai/eval/paid-replay-budget.mts';
async function fixture(){const store=new MemoryLinkStore();await store.change(s=>{s.devices.push({id:'phone',name:'synthetic',tokenHash:'hash',revoked:false});});const paid=new PaidReplayBudget({maxCny:1,maxCalls:10,price:{inputPerMillion:1,outputPerMillion:1,source:'synthetic'},journal:async()=>{}});const b=new LinkBudget(store,'scope',()=>paid.summary());await b.initialize();paid.externalReservedMicroCny=()=>b.blockedMicroCny;return{store,paid,b};}
test('phone allocation blocks desktop overspend and survives restart',async()=>{const {store,paid,b}=await fixture();await b.allocate('phone',900000);await assert.rejects(paid.execute({sampleId:'s',variant:'v',task:'decision'},100000,100000,async()=>({value:'no'})),/ADMISSION_REFUSED/);const restored=new LinkBudget(store,'scope',()=>paid.summary());await restored.initialize();assert.equal(restored.blockedMicroCny,900000);assert.equal(paid.summary().calls,0);});
test('allocation cannot shrink, oversubscribe, use revoked device or change scope',async()=>{const {store,b,paid}=await fixture();await b.allocate('phone',500000);await assert.rejects(b.allocate('phone',400000),/CANNOT_SHRINK/);await assert.rejects(b.allocate('phone',1000001),/EXHAUSTED/);await assert.rejects(new LinkBudget(store,'other',()=>paid.summary()).initialize(),/SCOPE_CHANGED/);await store.change(s=>{s.devices[0].revoked=true});await assert.rejects(b.allocate('phone',600000),/FORBIDDEN/);assert.equal(b.blockedMicroCny,500000);});
test('reports are monotone, idempotent, device scoped and cannot alter grant',async()=>{const {b}=await fixture();await b.allocate('phone',500000);assert.equal((await b.view('phone')).phones[0].lastReportedAt,undefined);const report={budgetId:'scope',spentMicroCny:100000,calls:2,tokens:100};await b.report('phone',{...report,deviceId:'evil',limitMicroCny:10000000} as any);await b.report('phone',report);const v=await b.view('phone');assert.equal(v.phones[0].deviceId,'phone');assert.equal(v.phones[0].limitMicroCny,500000);assert.ok(v.phones[0].lastReportedAt!>0);await assert.rejects(b.report('phone',{...report,spentMicroCny:0}),/REWIND/);await assert.rejects(b.report('phone',{...report,spentMicroCny:600000}),/EXHAUSTED/);await assert.rejects(b.report('other',report),/SCOPE_CHANGED/);});
test('outstanding desktop reservations are counted before granting phone funds',async()=>{const {b,paid}=await fixture();let release!:()=>void;const gate=new Promise<void>(r=>{release=r});const call=paid.execute({sampleId:'s',variant:'v',task:'decision'},400000,200000,async()=>{await gate;return{value:true,usage:{inputTokens:1,outputTokens:1}}});await assert.rejects(b.allocate('phone',500000),/EXHAUSTED/);release();await call;await b.allocate('phone',500000);assert.equal(b.blockedMicroCny,500000);});
test('PostgreSQL persists allocations and monotone usage in the owner scoped synchronization journal',{skip:!process.env.TEST_DATABASE_URL},async()=>{
 const {Pool,Client}=await import('pg');const admin=new Client({connectionString:process.env.TEST_DATABASE_URL});await admin.connect();const schema='link_budget_'+randomBytes(8).toString('hex');let pool:InstanceType<typeof Pool>|undefined;
 try{await admin.query(`CREATE SCHEMA ${schema}`);pool=new Pool({connectionString:process.env.TEST_DATABASE_URL,options:`-c search_path=${schema}`});await pool.query(await readFile('db/migrations/0014_mobile_link.sql','utf8'));const store=new PgLinkStore(pool,'synthetic-owner');await store.change(s=>{s.devices.push({id:'phone',name:'synthetic',tokenHash:'hash',revoked:false})});const summary=()=>({limitCny:1,accountedCny:.1,halted:false});const b=new LinkBudget(store,'scope',summary);await b.initialize();await b.allocate('phone',400000);await b.report('phone',{budgetId:'scope',spentMicroCny:10000,calls:1,tokens:100});const restored=new LinkBudget(new PgLinkStore(pool,'synthetic-owner'),'scope',summary);await restored.initialize();assert.equal(restored.blockedMicroCny,400000);assert.equal((await restored.view()).phones[0].spentMicroCny,10000);assert.deepEqual((await new PgLinkStore(pool,'other-owner').read()).devices,[]);await assert.rejects(restored.report('phone',{budgetId:'scope',spentMicroCny:0,calls:0,tokens:0}),/REWIND/);
 }finally{await pool?.end();await admin.query(`DROP SCHEMA ${schema} CASCADE`);await admin.end();}
});
